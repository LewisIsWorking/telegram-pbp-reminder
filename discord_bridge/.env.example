# Copy this file to ".env" (same folder) and fill in the two tokens.
# Real environment variables override anything set here.

# --- Required ---
# Discord bot token (Discord Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_BOT_TOKEN=your-discord-bot-token
# Telegram bot token (the SAME bot the rest of this project uses)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# --- Optional (sensible defaults shown) ---
# Telegram forum topic to post into. Default 119703 (Path Wars "voice" topic).
# TG_VOICE_TOPIC_ID=119703
# Telegram group id. Defaults to config.json's group_id if unset.
# TG_GROUP_ID=-1001661053273
# Restrict to a single Discord server (guild) id. Leave blank for all servers
# the bot is in. The bot prints its guild id on connect if you need it.
# DISCORD_GUILD_ID=
# Set true to also announce bot accounts joining/leaving voice. Default false.
# INCLUDE_BOTS=false
